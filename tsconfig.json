{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "_types/",
    "declarationMap": true,
    "module": "ES6",
    "moduleResolution": "node",
    "outDir": "build/",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES6",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "index.ts", "manual.ts"],
  "exclude": ["node_modules", "__tests__", "**/*.d.ts", "**/*.config.*", "**/build/**"]
}
